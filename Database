CREATE TABLE `candidate_applications` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `application_id` varchar(50) DEFAULT NULL,
  `candidate_id` varchar(50) DEFAULT NULL,
  `application_datetime` datetime DEFAULT NULL,
  `reg_no` varchar(50) DEFAULT NULL,
  `full_name` varchar(150) DEFAULT NULL,
  `department` varchar(100) DEFAULT NULL,
  `year` varchar(20) DEFAULT NULL,
  `gender` varchar(20) DEFAULT NULL,
  `dob` date DEFAULT NULL,
  `blood_group` varchar(10) DEFAULT NULL,
  `nationality` varchar(50) DEFAULT NULL,
  `aadhar` varchar(20) DEFAULT NULL,
  `email` varchar(150) DEFAULT NULL,
  `phone` varchar(20) DEFAULT NULL,
  `alt_phone` varchar(20) DEFAULT NULL,
  `current_address` text DEFAULT NULL,
  `permanent_address` text DEFAULT NULL,
  `district` varchar(100) DEFAULT NULL,
  `state` varchar(100) DEFAULT NULL,
  `pincode` varchar(10) DEFAULT NULL,
  `father_name` varchar(150) DEFAULT NULL,
  `father_occupation` varchar(100) DEFAULT NULL,
  `mother_name` varchar(150) DEFAULT NULL,
  `mother_occupation` varchar(100) DEFAULT NULL,
  `parent_mobile` varchar(20) DEFAULT NULL,
  `parent_email` varchar(150) DEFAULT NULL,
  `family_members_count` varchar(10) DEFAULT NULL,
  `sibling_details` text DEFAULT NULL,
  `college_name` varchar(150) DEFAULT NULL,
  `course` varchar(100) DEFAULT NULL,
  `specialization` varchar(100) DEFAULT NULL,
  `admission_year` varchar(20) DEFAULT NULL,
  `semester` varchar(20) DEFAULT NULL,
  `section` varchar(20) DEFAULT NULL,
  `cgpa` varchar(10) DEFAULT NULL,
  `attendance` varchar(10) DEFAULT NULL,
  `arrears` varchar(20) DEFAULT NULL,
  `backlog_count` varchar(10) DEFAULT NULL,
  `academic_achievements` text DEFAULT NULL,
  `election_year` varchar(20) DEFAULT NULL,
  `position` varchar(100) DEFAULT NULL,
  `constituency` varchar(100) DEFAULT NULL,
  `manifesto` text DEFAULT NULL,
  `eligibility_declaration` tinyint(1) DEFAULT NULL,
  `parent_consent` tinyint(1) DEFAULT NULL,
  `declaration` tinyint(1) DEFAULT NULL,
  `photo_path` varchar(255) DEFAULT NULL,
  `id_upload_path` varchar(255) DEFAULT NULL,
  `aadhar_upload_path` varchar(255) DEFAULT NULL,
  `bonafide_upload_path` varchar(255) DEFAULT NULL,
  `marksheet_upload_path` varchar(255) DEFAULT NULL,
  `attendance_cert_upload_path` varchar(255) DEFAULT NULL,
  `signature_upload_path` varchar(255) DEFAULT NULL,
  `created_at` timestamp NOT NULL DEFAULT current_timestamp(),
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;
